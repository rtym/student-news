# Example settings for docker-compose.yml. To override the defaults, copy
# this file to .env (git-ignored) and edit it:  cp .env.example .env
# Without a .env file Compose uses the defaults in docker-compose.yml.
# Postgres applies these only when its data volume is first created; after
# changing them, run `docker compose down -v` to start from a fresh volume.

# Name of the database created in the db container and used by the backend
POSTGRES_DB=student_news
# Database user the backend connects as
POSTGRES_USER=student
# Database password: choose your own and never commit the real value
POSTGRES_PASSWORD=change-me
