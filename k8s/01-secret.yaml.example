# EXAMPLE ONLY: placeholder values, safe to commit. This is the Kubernetes
# counterpart of .env.example.
#
# The file ends in .example on purpose: `kubectl apply -f k8s/` only reads
# .yaml, .yml and .json files, so it skips this one and can never overwrite
# your real Secret with the placeholders below.
#
# Two ways to create the real Secret (pick one):
#
#   1. Without a file (recommended, nothing to leak):
#
#        kubectl create secret generic db-credentials \
#          --namespace student-news \
#          --from-literal=POSTGRES_DB=student_news \
#          --from-literal=POSTGRES_USER=student \
#          --from-literal=POSTGRES_PASSWORD='choose-your-own'
#
#   2. From a file: copy this one to k8s/01-secret.yaml (git-ignored), put
#      your own password in the copy and `kubectl apply -f k8s/01-secret.yaml`.
#
# A Secret is NOT encrypted. Kubernetes stores the values base64-encoded,
# which anyone can decode, so a real Secret manifest never belongs in Git.
apiVersion: v1
kind: Secret
metadata:
  name: db-credentials
  namespace: student-news
type: Opaque
# stringData takes plain text and Kubernetes encodes it for you. The usual
# `data:` field needs every value base64-encoded by hand.
stringData:
  # Name of the database Postgres creates on first start. Keep it in sync
  # with the URL in the backend ConfigMap (03-backend.yaml).
  POSTGRES_DB: student_news
  # Database user the backend connects as
  POSTGRES_USER: student
  # Database password: choose your own and never commit the real value
  POSTGRES_PASSWORD: change-me
